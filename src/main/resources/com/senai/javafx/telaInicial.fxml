                    <userData>
                        <String fx:value="Playstation" />
                    </userData>
                </Button>

                <!-- XBOX -->
                <Button fx:id="btnXbox" layoutX="14.0" layoutY="537.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#filtrarConsole" prefWidth="183.0" styleClass="button, botao-categoria" text="        Xbox">
                    <userData>
                        <String fx:value="Xbox" />
                    </userData>
                </Button>

