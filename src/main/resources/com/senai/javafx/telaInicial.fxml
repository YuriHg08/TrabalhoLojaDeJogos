        <AnchorPane prefHeight="700.0" prefWidth="210.0" styleClass="sidebar-cliente" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="21.0" fitWidth="96.0" layoutX="15.0" layoutY="21.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@imagens/nexus.png" />
                    </image>
                    <effect>
                        <DropShadow>
                            <color>
                                <Color opacity="0.2633587718009949" />
                            </color>
                        </DropShadow>
                    </effect>
                </ImageView>
                <TextField fx:id="txtPesquisa" layoutX="15.0" layoutY="57.0" promptText="Buscar" styleClass="campo-texto" stylesheets="@styleMenu.css" />

