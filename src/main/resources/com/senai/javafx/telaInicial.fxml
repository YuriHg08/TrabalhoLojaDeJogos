                <!-- Os botões de categoria são gerados no controller a partir das categorias cadastradas -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutX="10.0" layoutY="213.0" prefHeight="185.0" prefWidth="190.0" styleClass="scroll-categorias">
                    <content>
                        <VBox fx:id="boxCategorias" spacing="6.0" />
                    </content>
                </ScrollPane>

                <!-- CONSOLES -->
                <Label layoutX="21.0" layoutY="409.0" styleClass="subtitulo-sidebar" text="Consoles" textFill="#4a4a4a" />

