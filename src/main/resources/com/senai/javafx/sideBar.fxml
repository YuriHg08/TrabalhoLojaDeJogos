<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="250.0" spacing="12.0" styleClass="sidebar" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.SidebarController">
    <padding>
        <Insets bottom="24.0" left="20.0" right="20.0" top="60.0" />
    </padding>
    <children>
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirCadastroCliente" styleClass="botao-secundario" text="Cadastrar cliente" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirCadastroCategorias" styleClass="botao-secundario" text="Cadastrar categorias" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirCadastroJogos" styleClass="botao-secundario" text="Cadastrar jogos" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirConsultarClientes" styleClass="botao-secundario" text="Consultar clientes" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirConsultarJogos" styleClass="botao-secundario" text="Consultar jogos" />

        <Region VBox.vgrow="ALWAYS" />

        <HBox prefHeight="38.0" prefWidth="209.0" spacing="10.0">
            <children>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#alternarConta" prefHeight="44.0" prefWidth="96.0" styleClass="botao-secundario" HBox.hgrow="ALWAYS">
               <graphic>
                  <ImageView fitHeight="33.0" fitWidth="33.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@AntDesignUserSwitchOutlined.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#alternarModoEscuro" prefHeight="55.0" prefWidth="94.0" styleClass="botao-secundario" HBox.hgrow="ALWAYS">
               <graphic>
                  <ImageView fitHeight="32.0" fitWidth="53.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@MaterialSymbolsLightMoonStarsRounded.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            </children>
        </HBox>
    </children>
</VBox>
