<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="483.0" prefWidth="250.0" spacing="12.0" styleClass="sidebar" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoAdministrador.SidebarController">
    <padding>
        <Insets bottom="24.0" left="20.0" right="20.0" top="60.0" />
    </padding>
    <children>
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirCadastroCliente" styleClass="botao-secundario" text="Cadastrar cliente" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirCadastroCategorias" styleClass="botao-secundario" text="Cadastrar categorias" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirCadastroJogos" styleClass="botao-secundario" text="Cadastrar jogos" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirConsultarClientes" styleClass="botao-secundario" text="Consultar clientes" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirConsultarJogos" styleClass="botao-secundario" text="Consultar jogos" />

        <Region VBox.vgrow="ALWAYS" />
      <AnchorPane prefHeight="61.0" prefWidth="210.0">
         <children>
                <Button layoutX="76.0" layoutY="12.0" maxWidth="Infinity" mnemonicParsing="false" onAction="#alternarConta" prefHeight="44.0" prefWidth="42.0">
               <styleClass>
                  <String fx:value="sidebar-btn" />
                  <String fx:value="sidebar-btn-bottom" />
               </styleClass>
            </Button>
            <ImageView fitHeight="23.0" fitWidth="23.0" layoutX="86.0" layoutY="20.0" pickOnBounds="true">
               <image>
                  <Image url="@imagens/AntDesignUserSwitchOutlined.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>
    </children>
</VBox>
