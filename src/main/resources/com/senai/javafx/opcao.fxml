<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1000.0" styleClass="modo-claro" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoAdministrador.MenuController">
   <children>
      <AnchorPane>
         <children>
            <VBox alignment="CENTER" layoutX="282.0" layoutY="34.0" maxWidth="420.0" prefHeight="633.0" prefWidth="420.0" spacing="14.0" styleClass="painel-principal">
               <padding>
                  <Insets bottom="36.0" left="32.0" right="32.0" top="36.0" />
               </padding>
               <children>
                  <Label alignment="CENTER" maxWidth="Infinity" styleClass="titulo-tela" text="Painel do administrador">
                     <VBox.margin>
                        <Insets bottom="4.0" />
                     </VBox.margin>
                  </Label>
            
                        <Label alignment="CENTER" maxWidth="Infinity" styleClass="subtitulo" text="Olá, selecione uma opção abaixo:">
                     <VBox.margin>
                        <Insets bottom="12.0" />
                     </VBox.margin>
                  </Label>
            
                              <!-- Ações principais do sistema -->
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#cadastroClientes" prefHeight="40.0" styleClass="botao-secundario" text="Cadastrar clientes" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#cadastroCategoria" prefHeight="40.0" styleClass="botao-secundario" text="Cadastrar categorias" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#cadastroJogos" prefHeight="40.0" styleClass="botao-secundario" text="Cadastrar jogos" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#consultarClientes" prefHeight="40.0" styleClass="botao-secundario" text="Consultar clientes" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#consultarJogos" prefHeight="40.0" styleClass="botao-secundario" text="Consultar jogos" />
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>
