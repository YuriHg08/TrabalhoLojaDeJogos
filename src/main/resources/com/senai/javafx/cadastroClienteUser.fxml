<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>

<StackPane alignment="CENTER" prefHeight="700.0" prefWidth="1200.0" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoCliente.CadastroClienteUserController">
    <children>
        <VBox alignment="CENTER" maxWidth="450.0" spacing="16.0" styleClass="card">
            <padding>
                <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
            </padding>
            <children>
            <ImageView fitHeight="47.0" fitWidth="225.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@imagens/nexus.png" />
               </image>
               <effect>
                  <DropShadow>
                     <color>
                        <Color opacity="0.3778626024723053" />
                     </color>
                  </DropShadow>
               </effect></ImageView>

                <!-- Subtítulo -->
                <Label styleClass="subtitulo" text="Crie sua conta!" />

                <!-- Formulário -->
                <VBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <!-- Nome / Usuário -->
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="label-campo" text="Nome / Usuário" />
                                <TextField fx:id="txtNome" promptText="Digite seu nome ou usuário" styleClass="campo-texto" />
                            </children>
                        </VBox>

                        <!-- Senha -->
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="label-campo" text="Senha" />
                                <PasswordField fx:id="txtSenha" promptText="Digite sua senha" styleClass="campo-texto" />
                            </children>
                        </VBox>

                        <!-- E-mail -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="6.0" />
                            </children>
                        </VBox>

                        <!-- Telefone -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="6.0" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Redirecionamento se já possuir conta -->
                <Button onAction="#handleIniciarSessao" style="-fx-background-color: transparent; -fx-text-fill: #8a8a8a; -fx-cursor: hand; -fx-font-size: 12px;" text="Já tem uma conta? Entre aqui" />

                <!-- Botões de Ação -->
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="btnCadastrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCadastrar" styleClass="button, botao-primario" text="Cadastrar" />
                    </children>
                    <VBox.margin>
                        <Insets top="4.0" />
                    </VBox.margin>
                </VBox>
                  <Button fx:id="btnVoltar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#voltarTela" styleClass="botao-secundario" text="Voltar" />
            <AnchorPane prefHeight="66.0" prefWidth="400.0" />

            </children>
        </VBox>
    </children>
</StackPane>
