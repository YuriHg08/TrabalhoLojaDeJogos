<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="475.0" prefWidth="603.0" styleClass="painel-principal" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.ConsultarJogosController">
    <children>
        <TableView fx:id="tabelaJogos" layoutX="35.0" layoutY="58.0" prefHeight="342.0" prefWidth="528.0" styleClass="table-row-cell" stylesheets="@style.css">
            <columns>
                <TableColumn fx:id="colImagemJogo" prefWidth="80.0" text="Capa" />
                <TableColumn fx:id="colNomeJogo" prefWidth="180.0" text="Nome" />
                <TableColumn fx:id="colCategoriaJogo" prefWidth="140.0" text="Categoria" />
                <TableColumn fx:id="colPrecoJogo" prefWidth="120.0" text="Preço" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Button layoutX="234.0" layoutY="419.0" mnemonicParsing="false" onAction="#voltarTela" prefHeight="36.0" prefWidth="130.0" styleClass="botao-secundario" text="Voltar" />
        <Label layoutX="35.0" layoutY="16.0" prefHeight="30.0" prefWidth="224.0" styleClass="titulo-tela" text="Jogos cadastrados" />
    </children>
</AnchorPane>