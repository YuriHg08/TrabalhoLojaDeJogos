<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoAdministrador.ConsultarJogosController">
    <left>
        <fx:include source="sideBar.fxml" />
    </left>
    <center>
        <VBox spacing="16.0" style="-fx-background-color: -cor-fundo;" stylesheets="@styleMenu.css">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label styleClass="titulo-tela" text="Jogos cadastrados" />

                <TableView fx:id="tabelaJogos" VBox.vgrow="ALWAYS">
                    <columns>
                        <!-- Coluna Estoque no lugar de Capa -->
                        <TableColumn fx:id="colEstoqueJogo" prefWidth="120.0" text="Estoque" />
                        <TableColumn fx:id="colNomeJogo" prefWidth="280.0" text="Nome" />
                        <TableColumn fx:id="colCategoriaJogo" prefWidth="220.0" text="Categoria" />
                        <TableColumn fx:id="colPrecoJogo" prefWidth="140.0" text="Preço" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
