<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="440.0" spacing="14.0" style="-fx-background-radius: 0;" styleClass="painel-principal" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoAdministrador.EditarAcessorioController">

    <padding>

        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label styleClass="titulo-tela" text="Editar acessório" />
            <Region HBox.hgrow="ALWAYS" />
            <Button focusTraversable="false" mnemonicParsing="false" onAction="#cancelar" prefHeight="31.0" prefWidth="48.0" style="-fx-text-fill: #ffffff;" stylesheets="@styleMenu.css" text="✕">
               <styleClass>
                  <String fx:value="titlebar-btn-close" />
                  <String fx:value="custom-titlebar" />
               </styleClass>
            </Button>
         </children>
      </HBox>
        <Label fx:id="lblInfo" styleClass="texto-mutado" wrapText="true" />


        <TextField fx:id="txtNomeAcessorio" prefHeight="38.0" promptText="Nome do acessório" styleClass="campo-texto" />
        <TextField fx:id="txtPrecoAcessorio" prefHeight="38.0" promptText="Preço (Ex: 599.90)" styleClass="campo-texto" />
        <TextField fx:id="txtEstoqueAcessorio" prefHeight="38.0" promptText="Estoque (Ex: 5)" styleClass="campo-texto" />

        <Label fx:id="lblResposta" alignment="CENTER" maxWidth="Infinity" prefHeight="24.0" styleClass="subtitulo" wrapText="true" />

        <HBox spacing="10.0">
            <children>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#cancelar" prefHeight="42.0" styleClass="botao-secundario" text="Cancelar" HBox.hgrow="ALWAYS" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#salvar" prefHeight="42.0" styleClass="botao-primario" text="Salvar" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
      <BorderPane prefHeight="200.0" prefWidth="200.0" />
    </children>
</VBox>
