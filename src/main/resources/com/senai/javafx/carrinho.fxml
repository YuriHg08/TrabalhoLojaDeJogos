<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoCliente.CarrinhoController">

    <!-- 1. BARRA DE TÍTULO CUSTOMIZADA NO TOPO -->
    <top>
        <fx:include source="titleBar.fxml" />
    </top>

    <!-- 2. CONTEÚDO DO CARRINHO NO CENTRO -->
    <center>
        <StackPane styleClass="root">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <VBox maxHeight="Infinity" maxWidth="900.0" spacing="16.0" styleClass="card">
                    <children>
                        <!-- Cabeçalho -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label styleClass="titulo-tela" text="Meu carrinho" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblContagem" styleClass="texto-mutado" />
                            </children>
                        </HBox>

                        <!-- Itens -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="custom-scroll-pane" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="listaItens" spacing="10.0" />
                            </content>
                        </ScrollPane>

                        <!-- Total -->
                        <HBox alignment="CENTER_RIGHT" spacing="14.0">
                            <children>
                                <Label styleClass="subtitulo" text="Total a pagar" />
                                <Label fx:id="lblTotal" styleClass="label-total" />
                            </children>
                        </HBox>
                        <Label styleClass="texto-ajuda" text="Pagando com Pix você ganha 5% de desconto; em dinheiro, 10%. O desconto é aplicado na tela de pagamento." wrapText="true" />

                        <!-- Ações -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#voltarLoja" styleClass="button, botao-secundario" text="← Voltar à loja" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnPagamento" mnemonicParsing="false" onAction="#irParaPagamento" styleClass="button, botao-primario" text="Ir para o pagamento" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>