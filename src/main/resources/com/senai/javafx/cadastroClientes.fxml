<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="320.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.CadastroClientesController">
   <children>

      <Label layoutX="35.0" layoutY="35.0" prefHeight="25.0" prefWidth="179.0" styleClass="titulo-tela" text="Cadastrar cliente">
         <font>
            <Font name="Inter Regular" size="16.0" />
         </font>
      </Label>


      <TextField fx:id="nomeField" layoutX="36.0" layoutY="150.0" prefHeight="32.0" prefWidth="250.0" promptText="Nome do cliente" styleClass="campo-texto" stylesheets="@style.css">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font>
      </TextField>

      <TextField fx:id="telefoneField" layoutX="36.0" layoutY="199.0" prefHeight="32.0" prefWidth="250.0" promptText="Telefone de contato" styleClass="campo-texto" stylesheets="@style.css" />

      <TextField fx:id="cpfField" layoutX="36.0" layoutY="249.0" prefHeight="32.0" prefWidth="250.0" promptText="CPF" styleClass="campo-texto" stylesheets="@style.css" />

      <Label fx:id="mensagem" layoutX="30.0" layoutY="250.0" prefWidth="223.0" />

      <Button layoutX="71.0" layoutY="381.0" mnemonicParsing="false" onAction="#salvar" prefHeight="25.0" prefWidth="179.0" styleClass="botao-primario" stylesheets="@style.css" text="Cadastrar">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font>
      </Button>
      <Button layoutX="71.0" layoutY="427.0" mnemonicParsing="false" onAction="#voltarTela" prefHeight="25.0" prefWidth="179.0" styleClass="botao-secundario" stylesheets="@style.css" text="Voltar" />
   </children>
</AnchorPane>
