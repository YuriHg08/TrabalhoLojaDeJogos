<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="430.0" prefWidth="283.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.CadastroClientesController">
   <children>

      <Label layoutX="73.0" layoutY="36.0" prefHeight="25.0" prefWidth="140.0" text="Cadastrar cliente">
         <font>
            <Font name="Inter Regular" size="16.0" />
         </font>
      </Label>


      <TextField fx:id="nomeField" layoutX="30.0" layoutY="105.0" prefHeight="32.0" prefWidth="223.0" promptText="Nome do cliente" styleClass="campo-texto" stylesheets="@style.css">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font>
      </TextField>

      <TextField fx:id="telefoneField" layoutX="30.0" layoutY="143.0" prefHeight="32.0" prefWidth="223.0" promptText="Telefone de contato" styleClass="campo-texto" stylesheets="@style.css" />

      <TextField fx:id="cpfField" layoutX="30.0" layoutY="183.0" prefHeight="32.0" prefWidth="223.0" promptText="CPF" styleClass="campo-texto" stylesheets="@style.css" />

      <Label fx:id="mensagem" layoutX="30.0" layoutY="250.0" prefWidth="223.0" />

      <Button layoutX="52.0" layoutY="297.0" mnemonicParsing="false" onAction="#salvar" prefHeight="25.0" prefWidth="179.0" styleClass="botao-primario" stylesheets="@style.css" text="Salvar">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font>
      </Button>
      <Button layoutX="52.0" layoutY="345.0" mnemonicParsing="false" onAction="#voltarTela" prefHeight="25.0" prefWidth="179.0" styleClass="botao-secundario" stylesheets="@style.css" text="Voltar" />
   </children>
</AnchorPane>
