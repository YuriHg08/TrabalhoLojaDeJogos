<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="modo-claro" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoAdministrador.CadastroClientesController">
   <left>
      <fx:include source="sideBar.fxml" />
   </left>
   <center>
      <StackPane style="-fx-background-color: -cor-fundo;">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <VBox maxWidth="480.0" spacing="16.0" styleClass="painel-principal">
               <children>
                  <Label styleClass="titulo-tela" text="Cadastrar cliente" />

                  <TextField fx:id="nomeField" prefHeight="38.0" promptText="Nome do cliente" styleClass="campo-texto" />
                  <TextField fx:id="telefoneField" prefHeight="38.0" promptText="Telefone de contato" styleClass="campo-texto" />
                  <TextField fx:id="cpfField" prefHeight="38.0" promptText="CPF" styleClass="campo-texto" />

                  <Label fx:id="mensagem" alignment="CENTER" maxWidth="Infinity" />

                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#salvar" prefHeight="40.0" styleClass="botao-primario" text="Salvar" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
