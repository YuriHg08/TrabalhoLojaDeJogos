<StackPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.HelloController">
    <children>
      <AnchorPane>
         <children>
            <Pane layoutX="319.0" layoutY="18.0" prefHeight="658.0" prefWidth="332.0" styleClass="dialog-pane">
