                            <Button fx:id="botaoEntrar" layoutX="29.0" layoutY="572.0" maxWidth="Infinity" mnemonicParsing="false" onAction="#prosseguirCadastro" prefHeight="40.0" prefWidth="271.0" styleClass="botao-primario" text="Entrar" />
               </children>
            </Pane>

                      <VBox layoutX="414.0" layoutY="241.0" spacing="6.0" />

