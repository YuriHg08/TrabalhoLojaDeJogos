<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoAdministrador.ConsultarAcessoriosController">
    <left>
        <fx:include source="sideBar.fxml" />
    </left>
    <top>
        <fx:include source="titleBar.fxml" />
    </top>
    <center>
        <VBox spacing="16.0" style="-fx-background-color: -cor-fundo;" stylesheets="@styleMenu.css">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="titulo-tela" text="Acessórios cadastrados" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#definirEstoqueDeTodos" styleClass="button, botao-primario" text="Definir estoque de todos" />
                    </children>
                </HBox>

                <TableView fx:id="tabelaAcessorios" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEstoque" prefWidth="90.0" text="Estoque" />
                        <TableColumn fx:id="colNome" prefWidth="280.0" text="Nome" />
                        <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                        <TableColumn fx:id="colPlataforma" prefWidth="120.0" text="Plataforma" />
                        <TableColumn fx:id="colPreco" prefWidth="120.0" text="Preço" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
