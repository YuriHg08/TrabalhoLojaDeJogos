<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="475.0" prefWidth="603.0" styleClass="painel-principal" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.ConsultarClienteController">
    <children>
        <TableView fx:id="tabela" layoutX="35.0" layoutY="58.0" prefHeight="342.0" prefWidth="528.0" styleClass="table-row-cell" stylesheets="@style.css">
            <columns>
                <TableColumn fx:id="colNome" prefWidth="140.0" text="Nome" />
                <TableColumn fx:id="colCpf" prefWidth="180.0" text="CPF" />
                <TableColumn fx:id="colTelefone" prefWidth="140.0" text="Telefone" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>

        <Button layoutX="234.0" layoutY="419.0" mnemonicParsing="false" onAction="#voltarTela" prefHeight="36.0" prefWidth="130.0" styleClass="botao-secundario" text="Voltar" />
      <Label layoutX="35.0" layoutY="16.0" prefHeight="30.0" prefWidth="224.0" styleClass="titulo-tela" text="Clientes cadastrados" />
    </children>
</AnchorPane>
