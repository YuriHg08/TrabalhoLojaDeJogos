<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoAdministrador.ConsultarClienteController">
    <left>
        <fx:include fx:id="sideBar" source="sideBar.fxml" />
    </left>
    <top>
        <fx:include source="titleBar.fxml" />
    </top>
    <center>
        <VBox spacing="16.0" style="-fx-background-color: -cor-fundo;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label styleClass="titulo-tela" text="Clientes cadastrados" />
                <Label fx:id="lblTotal" styleClass="texto-mutado" />

                <TableView fx:id="tabela" minHeight="120.0" prefHeight="190.0" VBox.vgrow="SOMETIMES">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome / Usuário" />
                        <TableColumn fx:id="colAcao" maxWidth="340.0" minWidth="260.0" prefWidth="280.0" text="Ação" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Compras já pagas pelos clientes: o admin escolhe a data e permite (ou recusa) -->
                <Label styleClass="titulo-tela" text="Compras aguardando aprovação">
                    <VBox.margin>
                        <Insets top="8.0" />
                    </VBox.margin>
                </Label>
                <Label fx:id="lblPendentes" styleClass="texto-mutado" />

                <TableView fx:id="tabelaPendentes" minHeight="160.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCompraNumero" maxWidth="70.0" minWidth="55.0" prefWidth="60.0" text="Nº" />
                        <TableColumn fx:id="colCompraCliente" prefWidth="110.0" text="Cliente" />
                        <TableColumn fx:id="colCompraCpf" prefWidth="120.0" text="CPF (chave Pix)" />
                        <TableColumn fx:id="colCompraItens" prefWidth="210.0" text="Itens" />
                        <TableColumn fx:id="colCompraPagamento" prefWidth="90.0" text="Pagamento" />
                        <TableColumn fx:id="colCompraTotal" prefWidth="100.0" text="Total" />
                        <TableColumn fx:id="colCompraData" minWidth="140.0" prefWidth="150.0" text="Data da compra" />
                        <TableColumn fx:id="colCompraAcoes" maxWidth="270.0" minWidth="220.0" prefWidth="250.0" text="Ações / Acesso" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
