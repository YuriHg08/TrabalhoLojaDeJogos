<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoAdministrador.CadastroCategoriasController">
   <left>
      <fx:include source="sideBar.fxml" />
   </left>
   <top>
      <fx:include source="titleBar.fxml" />
   </top>
   <center>
      <StackPane style="-fx-background-color: -cor-fundo;">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <VBox maxWidth="520.0" spacing="16.0" styleClass="painel-principal" stylesheets="@styleMenu.css">
               <children>
                  <Label styleClass="titulo-tela" text="Cadastrar categoria" />

                  <Label styleClass="label-campo" text="Categorias disponíveis" />
                  <ListView fx:id="exibicaoCategorias" prefHeight="180.0" />

                  <TextField fx:id="nomeCategoria" prefHeight="38.0" promptText="Nome da nova categoria" styleClass="campo-texto" />
                  <Label fx:id="resposta" alignment="CENTER" maxWidth="Infinity" textFill="WHITE" />

                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#botaoCadastrarCategoria" prefHeight="40.0" styleClass="botao-primario" text="Cadastrar" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
