<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.CadastroJogosController">
    <left>
        <fx:include source="sideBar.fxml" />
    </left>
    <center>
        <StackPane style="-fx-background-color: -cor-fundo;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <VBox maxWidth="540.0" spacing="16.0" styleClass="painel-principal">
                    <children>
                        <Label styleClass="titulo-tela" text="Cadastrar um jogo" />

                        <TextField fx:id="txtNomeJogo" prefHeight="38.0" promptText="Nome do jogo" styleClass="campo-texto" />
                        <TextField fx:id="txtPrecoJogo" prefHeight="38.0" promptText="Preço (Ex: 59.90)" styleClass="campo-texto" />
                        <ComboBox fx:id="menuCategoria" maxWidth="Infinity" prefHeight="38.0" promptText="Selecione uma categoria" styleClass="combo-box" />

                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <children>
                                <ImageView fx:id="imgPreview" fitHeight="85.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
                                <Button fx:id="btnEscolherImagem" maxWidth="Infinity" mnemonicParsing="false" onAction="#selecionarImagem" prefHeight="42.0" styleClass="botao-secundario" text="Escolher Capa..." HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <Label fx:id="respostaJogo" alignment="CENTER" maxWidth="Infinity" styleClass="label-campo" />

                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#cadastrarJogo" prefHeight="40.0" styleClass="botao-primario" text="Cadastrar" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>