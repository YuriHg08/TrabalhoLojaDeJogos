<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane alignment="CENTER" prefHeight="700.0" prefWidth="1200.0" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoCliente.DetalhesJogosController">
    <children>
        <VBox alignment="TOP_CENTER" maxWidth="700.0" spacing="20.0" styleClass="card">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="25.0" />
            </padding>
            <children>

                <!-- Botão Voltar -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#handleVoltar" styleClass="button, botao-secundario" text="← VOLTAR A EXPLORAR" />
                    </children>
                </HBox>

                <!-- Título Dinâmico do Jogo -->
                <Label fx:id="lblNomeJogo" alignment="CENTER" styleClass="titulo-banner" text="" textAlignment="CENTER" wrapText="true" />

                <!-- Area da Imagem com Moldura Neon -->
                <StackPane maxWidth="400.0" minHeight="260.0" prefHeight="280.0" styleClass="imagem-placeholder">
                    <children>
                        <ImageView fx:id="imgJogo" fitHeight="270.0" fitWidth="390.0" preserveRatio="true" />
                    </children>
                </StackPane>

                <!-- Badge Dinâmica: CATEGORIA | CONSOLE -->
                <HBox alignment="CENTER" maxWidth="380.0" style="-fx-background-color: -cor-superficie-alt; -fx-background-radius: 20px; -fx-padding: 8px 16px; -fx-border-color: -cor-borda; -fx-border-radius: 20px;">
                    <children>
                        <Label fx:id="lblInfoExtra" style="-fx-font-size: 13px; -fx-text-fill: -cor-texto-secundario;" styleClass="label-campo" text="" />
                    </children>
                </HBox>

                <!-- Seletor de Quantidade -->
                <HBox alignment="CENTER" maxWidth="400.0" prefHeight="48.0" spacing="15.0" styleClass="capsula-quantidade">
                    <children>
                        <Label styleClass="label-quantidade" text="QUANTIDADE:" />
                        <Spinner fx:id="spnQuantidade" prefWidth="100.0" styleClass="spinner-custom" />
                    </children>
                </HBox>

                <!-- Botão Dinâmico: COMPRAR R$ XXX,XX -->
                <Button fx:id="btnComprar" maxWidth="400.0" mnemonicParsing="false" onAction="#handleComprar" style="-fx-font-size: 16px; -fx-pref-height: 48px; -fx-background-radius: 24px;" styleClass="button, botao-primario" stylesheets="@styleMenu.css" text="COMPRAR" />

            </children>
        </VBox>
    </children>
</StackPane>
