<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@styleMenu.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.javafx.controllers.LadoCliente.DetalhesJogosController">
    <center>
    <StackPane alignment="CENTER">
    <children>
        <VBox alignment="TOP_CENTER" maxWidth="700.0" prefHeight="700.0" prefWidth="634.0" spacing="20.0" styleClass="card">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="25.0" />
            </padding>
            <children>

                <!-- Botão Voltar -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#handleVoltar" prefWidth="166.0" styleClass="button, botao-secundario" text="Voltar ao Início" />
                    </children>
                </HBox>

                <!-- Título Dinâmico do Jogo -->
                <Label fx:id="lblNomeJogo" alignment="CENTER" styleClass="titulo-banner" text="" textAlignment="CENTER" wrapText="true" />

                <!-- Area da Imagem com Moldura Neon -->
                <StackPane maxWidth="400.0" minHeight="260.0" prefHeight="280.0" styleClass="imagem-placeholder">
                    <children>
                        <ImageView fx:id="imgJogo" fitHeight="270.0" fitWidth="379.0" preserveRatio="true" />
                    </children>
                </StackPane>

                <!-- Badge Dinâmica: CATEGORIA | CONSOLE -->
                <HBox alignment="CENTER" maxWidth="380.0" prefHeight="14.0" prefWidth="380.0" style="-fx-background-color: -cor-superficie-alt; -fx-background-radius: 8; -fx-padding: 8px 16px; -fx-border-color: -cor-borda; -fx-border-radius: 8px;">
                    <children>
                        <Label fx:id="lblInfoExtra" style="-fx-font-size: 13px; -fx-text-fill: -cor-texto-secundario;" styleClass="label-campo" text="" />
                    </children>
                </HBox>
                  <AnchorPane>
                     <children>
                        <Label layoutX="226.0" layoutY="10.0" styleClass="texto-ajuda" stylesheets="@styleMenu.css" text="Quantidade" textFill="WHITE" />
                        <Spinner fx:id="spnQuantidade" layoutX="218.0" layoutY="32.0" prefHeight="40.0" prefWidth="215.0" styleClass="spinner-custom" />
                     </children>
                  </AnchorPane>

                <!-- Estoque disponível -->
                <Label fx:id="lblEstoque" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" />

                <!-- Botão Dinâmico: COMPRAR R$ XXX,XX -->
                <Button fx:id="btnComprar" maxWidth="400.0" mnemonicParsing="false" onAction="#handleComprar" prefWidth="721.0" style="-fx-font-size: 16px; -fx-pref-height: 48px; -fx-background-radius: 10px;" styleClass="button, botao-primario" stylesheets="@styleMenu.css" text="Comprar" />

            </children>
        </VBox>
    </children>
    </StackPane>
    </center>

    <!-- Barra "Ir para o carrinho": criada pelo controller (só aparece quando há itens no carrinho).
         Não dá para usar <BarraCarrinho/> aqui: o FXMLLoader confunde a pasta "LadoCliente" (maiúscula) com uma classe. -->
    <bottom>
        <StackPane fx:id="rodape" />
    </bottom>
</BorderPane>
